# Normalise source line endings, but never touch binary assets.
* text=auto

*.dart   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.php    text eol=lf
*.js     text eol=lf

*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.jar    binary
*.keystore binary
*.jks    binary
*.sqlite binary
