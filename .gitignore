# ---------------------------------------------------------------------------
# Kuphanda monorepo — only source, configuration and seed assets are tracked.
# Generated output, dependencies, secrets and machine-specific files stay out.
# ---------------------------------------------------------------------------

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
*.swp
*.swo

# Local logs and screenshots
*.log
/screenshots/
phanda_app/screenshots/

